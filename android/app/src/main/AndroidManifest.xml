<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Aktualizacja z serwera WERTIS (0.48.0). Uprawnienie jest instalacyjne, ale
      NIE WYSTARCZA: człowiek musi jeszcze zgodzić się w ustawieniach Androida
      na instalowanie z tej aplikacji. Kolektor pyta o to sam, zanim cokolwiek
      pobierze — patrz `AktualizacjaRepository`.

      Zastrzeżenia sklepu Play tego nie dotyczą: APK nigdy tam nie trafia,
      jedzie po sieci magazynu. Nie usuwać „na wszelki wypadek".
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Zdjęcie dowodowe robi systemowy aparat. NIE deklarujemy CAMERA:
         ACTION_IMAGE_CAPTURE jej nie wymaga, a deklaracja wymusiłaby pytanie
         o uprawnienie w alejce. Na Androidzie 11+ intencja musi być widoczna. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".WertisApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Wertis"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Aparat pisze do cache aplikacji; plik ginie zaraz po zakodowaniu. -->
        <!--
          Wynik sesji instalatora. W MANIFEŚCIE, bo instalacja zabija nasz
          proces — odbiornik rejestrowany w kodzie nie dożyłby odpowiedzi.
        -->
        <receiver
            android:name=".update.WynikInstalacji"
            android:exported="false">
            <intent-filter>
                <action android:name="pl.wertis.kolektor.INSTALACJA" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
