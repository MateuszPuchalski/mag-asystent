{
  // Build produkcyjny: to samo co tsconfig.json, ale bez testów w dist.
  //
  // Do 0.491.2 poza dist stały też wsady roczne (reslot, rekoncyliacja), bo
  // chodziły z checkoutu przez tsx. Paczka wydania (`tools/paczka.sh`) nie ma
  // ani checkoutu, ani tsx — to narzędzie deweloperskie — więc wsad spoza dist
  // nie dałby się uruchomić wcale. Testy zostają w tsconfig.json, żeby
  // `tsc --noEmit` nadal je sprawdzał.
  "extends": "./tsconfig.json",
  "exclude": ["src/**/*.test.ts"]
}
