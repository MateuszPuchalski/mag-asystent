{
  "name": "@wertis/server",
  "private": true,
  "version": "0.197.2",
  "type": "module",
  "description": "WERTIS — serwer API + worker Sfery (Fastify, SQLite).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/worker.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:scenariusze": "tsx src/db/seed-scenariusze.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.copyFileSync('src/db/schema.sql','dist/db/schema.sql');f.mkdirSync('dist/web',{recursive:true});f.copyFileSync('src/web/biuro.html','dist/web/biuro.html');f.cpSync('src/web/fonty','dist/web/fonty',{recursive:true});f.cpSync('../panel/dist','dist/web/obsluga',{recursive:true})\"",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/worker.js",
    "test": "tsx --test --test-reporter=dot src/*.test.ts src/**/*.test.ts",
    "test:licznik": "tsx --test --test-reporter=tap src/*.test.ts src/**/*.test.ts | grep -E '^# (tests|pass|fail)'",
    "reconcile": "tsx src/reconcile-run.ts",
    "reslot": "tsx src/reslot-run.ts",
    "sonda": "tsx src/sonda-run.ts",
    "inwentarz": "tsx src/inwentarz-run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "fastify": "^5.2.1",
    "mssql": "^11.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
