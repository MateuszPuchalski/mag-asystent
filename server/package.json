{
  "name": "@wertis/server",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "WERTIS — serwer API + worker Sfery (Fastify, SQLite).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/worker.ts",
    "seed": "tsx src/db/seed.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/worker.js",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "reconcile": "tsx src/reconcile-run.ts",
    "start:reconcile": "node dist/reconcile-run.js",
    "reslot": "tsx src/reslot-run.ts",
    "start:reslot": "node dist/reslot-run.js"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
