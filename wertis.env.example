# WERTIS — ustawienia środowiska (szablon)
#
#   cp wertis.env.example wertis.env     # i uzupełnij wartości
#   npm start                            # API
#   npm -w server run start:worker       # worker, drugie okno
#
# JEDEN plik dla OBU procesów — czytają go z dysku same, nie trzeba go nigdzie
# przepisywać ani wołać `source`. API i worker to osobne procesy: gdyby tylko
# jeden dostał SGT_MODE=mssql, zapisy po cichu wylądowałyby w lokalnej bazie
# aplikacji zamiast w Subiekcie, a zadanie i tak zgłosiłoby sukces.
#
# Szukany obok pliku wykonywalnego, a przy uruchomieniu z repo — w katalogu
# roboczym. Inną ścieżkę wskazuje WERTIS_ENV_FILE.
#
# Zmienne środowiskowe MAJĄ PIERWSZEŃSTWO nad tym plikiem (wygodne w dev).
# Bezpieczeństwo nie stoi na tej regule, tylko na /api/health, które porównuje
# tryb obu procesów i krzyczy przy rozjeździe.
#
# wertis.env jest w .gitignore — trzyma hasło.

# ── Tryb ────────────────────────────────────────────────────────────────────
# seeded = dane demo z magmat.xlsx, ZERO kontaktu z Subiektem (pilot, Etap 0);
#          na pustej bazie loguje się od razu kontem demo admin/admin (0.53.2)
# mssql  = prawdziwa baza Subiekta GT (Etap 1)
export SGT_MODE=mssql

# ── Połączenie z MSSQL Subiekta ─────────────────────────────────────────────
export MSSQL_SERVER=localhost
export MSSQL_INSTANCE=INSERTGT      # albo zamiast tego: export MSSQL_PORT=1433
export MSSQL_DATABASE=NAZWA_BAZY    # nazwa podmiotu (pasek tytułu Subiekta)
export MSSQL_USER=wertis            # login z docs/subiekt-gt-edu-setup.md §2
export MSSQL_PASSWORD=silne-haslo

# ── Kolumna lokalizacji ─────────────────────────────────────────────────────
# Wersje z KSeF nie mają natywnego tw_Lokalizacja — lokalizacja siedzi
# w jednym z ośmiu pól własnych tw_Pole1..8 (każde varchar(50)).
export MSSQL_LOC_COLUMN=tw_Pole1

# ── Magazyny ([WERYFIKUJ] — SELECT z DEPLOY §6) ─────────────────────────────
# Magazyn skutku rozstrzyga, którym trybem idzie dokument.
export MAG_ID_MAG=1
export MAG_ID_MGP=2
export MAG_ID_ZWROTY=3

# ── Zamówienia u dostawcy ([WERYFIKUJ] — SELECT-y z DEPLOY §6) ──────────────
# Karta towaru pokazuje, co jest zamówione i jeszcze nie przyjechało.
# Bez tych dwóch wpisów działa, tylko mniej dokładnie — patrz niżej.
#
# Które dok_Status znaczą „zamówienie otwarte". Struktura InsERT mówi tylko
# „5..8 — zamówienia (różne stany realizacji)", więc domyślne bierze wszystkie
# cztery. To ZAŁOŻENIE: sprawdź rozkład u siebie i zawęź.
#export DOK_STATUS_ZD_OTWARTE=5,6,7,8
#
# Kolumna dok_Pozycja z ilością JUŻ ODEBRANĄ.
#
# UWAGA: w części wersji Subiekta TAKIEJ KOLUMNY NIE MA WCALE — sprawdzono to na
# bazie 1.8731.31.6933, gdzie dok_Pozycja nie niesie stopnia realizacji w żadnym
# polu. Wtedy poprawnym ustawieniem jest WARTOŚĆ PUSTA: /api/health przestaje
# zgłaszać problem, którego nie da się rozwiązać ustawieniem, a karta dalej
# opisuje ilość jako oszacowanie.
#
# Zostawiona nazwa nieistniejącej kolumny daje to samo zachowanie, ale plus
# ostrzeżenie, którego nie można spełnić — a takie ostrzeżenia uczą ignorowania
# ostrzeżeń. Nazwę sprawdź zapytaniem z DEPLOY.md §6.
#export MSSQL_ZD_ZREAL_COLUMN=
#
# Termin realizacji zamówienia. Puste = karta pisze „termin nieznany", co jest
# uczciwsze niż podstawienie daty wystawienia w miejsce obietnicy dostawy.
#export MSSQL_ZD_TERMIN_COLUMN=

# ── Lista rozkładania: co na niej ląduje ────────────────────────────────────
#
# Typy dokumentów uznawanych za DOSTAWĘ do rozłożenia. Domyślnie 1 — sama
# faktura zakupu. Tak jest w firmie, dla której to powstało: PZ pochodzi
# z zupełnie innego procesu i na liście pracy magazyniera byłoby szumem.
#
# Ustaw 1,10, jeśli u Was towar wchodzi OBIEMA drogami — fakturą zakupu i
# przyjęciem zewnętrznym. Dla magazyniera to wtedy ta sama praca: paleta
# do rozłożenia.
#export DOK_TYPY_DOSTAW=1
#
# Ile dni wstecz sięga lista dostaw. Domyślnie 14.
#
# To okno IMPORTU — dokument spoza niego nie trafia do read-modelu w ogóle,
# a od 0.12.3 rządzi też zakresem samej listy (wcześniej trasa miała 14 zaszyte
# i to ustawienie działało tylko w połowie). Dostawa NIEROZŁOŻONA DO KOŃCA
# zostaje widoczna niezależnie od wieku, więc skrócenie okna nie kasuje z ekranu
# niedokończonej pracy.
#export DOK_DNI_WSTECZ=14

# ── Worker Sfery: dokumenty MM (DEPLOY §6 etap 2, sfera-worker/README.md) ───
#
# Domyślnie WYŁĄCZONE: zadania MM kończą się czytelnym błędem, a dokument
# wystawia biuro w Subiekcie. Włączenie przenosi zadania MM do osobnej usługi
# wertis-sfera (C#, COM Sfery — wymaga licencji) i każe workerowi Node ich
# nie dotykać. Nie włączaj bez działającego exe: MM wisiałyby w kolejce,
# a serwer przy SGT_MODE=seeded w ogóle odmówi startu.
#export SFERA_WORKER=1
#
# Operator Subiekta z prawem wystawiania MM (konto Subiekta, NIE login SQL).
#export SFERA_OPERATOR=
#export SFERA_OPERATOR_HASLO=

# ── Zdjęcia kartotek na karcie towaru (0.30.0) ──────────────────────────────
#
# Domyślnie WYŁĄCZONE (puste ZDJECIA_ZRODLO): karta pokazuje pusty slot i nikt
# nie pyta bazy Subiekta o nic. Ten jeden klucz jest zarazem wyłącznikiem
# i wyborem źródła — dwa osobne mogłyby się rozjechać ze sobą.
#
# USTALONE na bazie tej firmy (2026-08-08): zdjęcia leżą w tw_ZdjecieTw.
# Komplet z uzasadnieniem — docs/subiekt-gt-struktura.md, rozdział „Gdzie
# Subiekt trzyma zdjęcie kartoteki". Wymaga siódmego GRANT SELECT na tę tabelę.
#
#export ZDJECIA_ZRODLO=blob
#export ZDJECIA_TABELA=tw_ZdjecieTw
#export ZDJECIA_KOLUMNA_KLUCZA=zd_IdTowar
#export ZDJECIA_KOLUMNA=zd_Zdjecie
# Kartoteka może mieć KILKA zdjęć („Ustaw jako główną" i „Sortuj" w Subiekcie).
# zd_IdTowar jest kluczem OBCYM, więc porządku nie domyka — robi to dopiero
# zd_Id. Bez tego serwer nie wystartuje: wybór byłby losowy przy każdym odczycie.
#export ZDJECIA_KOLUMNA_GLOWNE=zd_Glowne
#export ZDJECIA_KOLUMNA_KOLEJNOSC=zd_Id
#
# Wariant „zdjęcia leżą w katalogu, nie w bazie". Konto usługi wertis-api musi
# mieć do niego dostęp do ODCZYTU.
#export ZDJECIA_ZRODLO=plik
#export ZDJECIA_KATALOG=D:\zdjecia
#export ZDJECIA_WZORZEC_PLIKU={symbol}.jpg
#
# Serwer NIE zmniejsza obrazów (zero modułów natywnych), więc jedyną obroną
# przed kartoteką ze skanem 20 MB jest odmowa. Ile naprawdę ważą zdjęcia
# w tej bazie, pokaże /api/health po pierwszym dniu pracy.
#export ZDJECIA_MAX_KB=2048
#export ZDJECIA_CACHE_MB=512
#export ZDJECIA_TTL_H=168
# Jak długo pamiętamy, że kartoteka zdjęcia NIE MA. Musi być krótsze niż doba:
# kolektor pamięta brak przez 24 h i obiecuje, że zdjęcie dodane dziś w Subiekcie
# pokaże najdalej jutro. Dłuższa pamięć serwera opóźniałaby je o tydzień.
#export ZDJECIA_BRAK_TTL_H=12

# ── Dodawanie zdjęcia kartoteki z kolektora (0.88.0) ────────────────────────
#
# Kartoteka bez zdjęcia pokazuje na karcie pusty slot. Ten klucz zamienia go
# w przycisk: magazynier robi zdjęcie albo wybiera je z galerii, serwer wycina
# tło, a człowiek ogląda wynik przed zapisem.
#
# JEDEN KLUCZ jest zarazem wyłącznikiem i wyborem miejsca zapisu — tak samo
# jak ZDJECIA_ZRODLO wyżej i z tego samego powodu.
#
#   puste    (domyślnie) zdjęcia nie da się dodać; karta wygląda jak przed 0.88.0
#   wertis   zdjęcie zostaje w bazie WERTIS i widać je na karcie — DZIAŁA ZAWSZE
#   subiekt  dodatkowo wchodzi do kartoteki w Subiekcie — MA WARUNKI WSTĘPNE
#
# UWAGA: `subiekt` NIE jest równorzędnym wyborem wobec `wertis`. Zakłada, że na
# tej instalacji działa już ODCZYT zdjęć — czyli ZDJECIA_ZRODLO=blob wraz
# z ZDJECIA_TABELA, ZDJECIA_KOLUMNA_KLUCZA i ZDJECIA_KOLUMNA_GLOWNE, przy
# SGT_MODE=mssql. Bez kompletu SERWER ODMAWIA STARTU: to nie jest „funkcja nie
# zadziała", tylko wertis-api nie wstaje (NSSM melduje SERVICE_PAUSED). Powód
# stoi w logu usługi, a wycofanie polega na wyczyszczeniu tego klucza.
#
# Gdy nie masz pewności, czy odczyt zdjęć jest włączony — zostaw `wertis`.
# Zdjęcia będą działać na kolektorze od razu, a do kartoteki przeniesiesz je
# później, bez zmiany czegokolwiek w kolektorze.
#
# `subiekt` żąda ÓSMEGO uprawnienia i jest to PIERWSZE prawo dopisywania
# wiersza do bazy firmy, jakie ta aplikacja ma:
#
#   GRANT INSERT ON dbo.tw_ZdjecieTw TO wertis;
#
# Nadaje je instalator uruchomiony z -ZdjeciaZapis. Bez tego prawa funkcja NIE
# przestaje działać: zdjęcie leży w bazie WERTIS i widać je na karcie, a zadanie
# `set_zdjecie` stoi w kolejce z czytelnym błędem — tak samo jak kod kreskowy
# działa przez `ean_alias` mimo nieudanego `set_ean`.
#
#export ZDJECIA_DODAWANIE=wertis
#
# Ile kilobajtów wolno przyjąć od kolektora. Kolektor zmniejsza zdjęcie przed
# wysyłką (1600 px), więc przekroczenie tej liczby znaczy, że coś poszło
# z jego pominięciem — i wtedy odmowa jest odpowiedzią właściwą.
#export ZDJECIA_UPLOAD_MAX_KB=512
#
# Ile minut żyje podgląd między zrobieniem zdjęcia a jego zatwierdzeniem.
# Człowiek ogląda wycięte tło kilkanaście sekund; kwadrans to zapas na
# przerwane połączenie i na kolektor odłożony w połowie roboty.
#export ZDJECIA_PODGLAD_MIN=15

# ── Usługa usuwania tła: wertis-tlo (0.88.0, tlo-worker/README.md) ──────────
#
# CZWARTY proces, obok wertis-api, wertis-worker i wertis-sfera. Model chodzi
# na runtime ONNX, czyli na module natywnym, a serwer WERTIS ma dwie zależności
# i zero modułów natywnych — ta sama reguła, przez którą zdjęcia kartotek nie są
# skalowane, a loga dostawców przerabia przeglądarka.
#
# Domyślnie WYŁĄCZONE (puste TLO_URL). Bez usługi zdjęcia zapisują się Z TŁEM
# i kolektor mówi o tym wprost — funkcja nie przestaje działać, tylko robi mniej.
#export TLO_URL=http://127.0.0.1:8791
#
# Ile milisekund czeka SERWER. To granica cierpliwości człowieka stojącego przy
# regale, nie granica modelu: po jej upływie podgląd pokazuje zdjęcie z tłem.
#export TLO_TIMEOUT_MS=20000
#
# Poniższe dwa klucze czyta WYŁĄCZNIE usługa wertis-tlo.
# Plik modelu; domyślnie model\u2netp.onnx obok exe.
#export TLO_MODEL=C:\wertis\tlo-worker\model\isnet-general-use.onnx
# Dłuższy bok zapisywanego zdjęcia.
#export TLO_BOK=1024

# ── Pozycje dokumentu, które NIE są towarem (0.35.0) ────────────────────────
#
# Na fakturze zakupu bywa wiersz PRZESYŁKA / „koszt transportu". Nie ma go czym
# zeskanować ani gdzie położyć, więc wypada z rozkładania W OGÓLE — nie da się
# go odłożyć, pominąć ani zgłosić jako problem, i nie wisi do końca dnia jako
# jedyna niezałatwiona pozycja. Uzasadnienie: server/src/pomijane.ts.
#
# Wpisuje się SYMBOL kartoteki (CSV), nie opis — opis jest polem swobodnym
# i różni się między dostawcami. Wielkość liter, polskie ogonki i myślniki nie
# mają znaczenia, więc „przesylka" i „PRZESYŁKA" to jedno ustawienie.
# Puste = funkcja wyłączona, wszystkie pozycje idą na listę jak dotąd.
#export POZYCJE_NIE_TOWAROWE=PRZESYŁKA

# ── Zwroty Allegro (0.53.0) ─────────────────────────────────────────────────
#
# Domyślnie WYŁĄCZONE (puste ALLEGRO_CLIENT_ID): zakładka ZWROTY w /biuro mówi
# wprost, że funkcji nie ma. Client_id i secret wydaje rejestracja aplikacji na
# https://developer.allegro.pl (typ „urządzenie” — device flow, bez redirect
# URI). Samo KONTO sprzedawcy paruje się już z panelu /biuro (karta KONTO
# ALLEGRO, rola admin) — token mieszka w bazie aplikacji, nie tutaj, bo każde
# odświeżenie wydaje nową parę.
#export ALLEGRO_CLIENT_ID=
#export ALLEGRO_CLIENT_SECRET=
#
# Nagłówek User-Agent — WYMAGANY, nie opcjonalny. Allegro żąda go w KAŻDYM
# żądaniu i ostrzega, że brak grozi zablokowaniem klucza API; blokada adresu
# IP wygląda potem jak awaria integracji. Po rejestracji aplikacji kliknij
# „Wygeneruj nagłówek User-Agent" i wklej wartość tutaj. Pusta wartość daje
# fallback WERTIS/<wersja>, a STAN SYSTEMU zgłosi to jako problem.
export ALLEGRO_USER_AGENT=
#
# 1 = środowisko testowe (allegro.pl.allegrosandbox.pl). Token nie przeżywa
# zmiany środowiska — po przełączeniu trzeba sparować konto ponownie.
#export ALLEGRO_SANDBOX=0
#
# Wymuszenie adaptera: dev = fikcyjne zwroty (demo/testy, zero sieci),
# http = prawdziwe API. Puste = wynika z SGT_MODE (seeded→dev, mssql→http).
#export ALLEGRO_MODE=
#
# Co ile milisekund serwer SAM pyta Allegro o zapowiedzi zwrotów i o pytania
# klientów. Domyślne 0 znaczy: nie pyta wcale — pobiera człowiek przyciskiem
# POBIERZ Z ALLEGRO (karta ZWROTY) i ODŚWIEŻ Z ALLEGRO (karta PYTANIA).
#
# Tak jest od 0.85.0 i to jest decyzja właściciela, nie oszczędność: ruch
# w tle idzie na cudzy serwis, a Allegro potrafi zablokować całą sieć, z której
# przychodzi ruch wyglądający na automat. Liczba (np. 300000 = 5 minut)
# przywraca pobieranie w tle.
#
# Token na tym nie traci: refresh Allegro żyje kwartał i odnawia się przy
# KAŻDYM użyciu, a skan etykiety zwrotu też go używa.
#
# MINIMUM to 60000 (minuta). Wartość dodatnia poniżej minuty zatrzymuje start
# serwera — to niemal na pewno literówka (sekundy zamiast milisekund),
# a skutkiem byłyby trzy pętle bijące w Allegro maszynowym rytmem.
# Od 0.109.1 rytm ma rozrzut ±10% i respektuje prośbę Allegro o przerwę (429).
#export ALLEGRO_POLL_MS=0
#
# Ręczne WPISYWANIE lokalizacji na kolektorze (obok skanowania). Domyślnie
# włączone. `0` chowa tę ścieżkę na trzech ekranach kolektora — dyscyplina
# „tylko skan" dla magazynów, w których każda półka ma etykietę z kodem.
#export ALLOW_MANUAL_LOC=1
#
# Ile dni od zgłoszenia ma firma na odpowiedź w sprawie reklamacji.
# Ustawowy termin to 14 dni — po nim reklamacja jest uznana z mocy prawa.
# Lista reklamacji sortuje się po dniach do TEJ daty.
#export REKLAMACJA_DNI=14
#
# Dokumenty SPRZEDAŻY w read-modelu — do automatycznego dopasowania zwrotu.
# Kody z tej samej listy co DOK_TYPY_DOSTAW, więc pewne: 2=FS, 21=PA.
#export DOK_TYP_FS=2
#export DOK_TYP_PA=21
#
# Ile dni wstecz importować sprzedaż. Szersze niż okno dostaw, bo paczka
# wraca i po dwóch miesiącach; dokument nierozliczonego zwrotu zostaje
# w imporcie niezależnie od wieku.
#export DOK_SPRZEDAZ_DNI_WSTECZ=90
#
# Gdzie integracja sprzedażowa zostawia numer zamówienia Allegro na dokumencie.
# Obie kolumny ISTNIEJĄ w bazie 1.8731.31.6933 (dok_NrPelnyOryg varchar 30,
# dok_Uwagi varchar 500) — [WERYFIKUJ] zostaje tylko to, czy integracja
# faktycznie wpisuje tam numer (DEPLOY §6a). Numer w którymkolwiek polu czyni
# dopasowanie jednoznacznym; bez niego zostaje nakładka pozycji + ręczny wybór.
# Nieistniejąca kolumna NIE przerywa importu — drugie podejście bez niej
# i zdanie w /api/health. Puste = świadoma rezygnacja z sygnału.
#export MSSQL_SPRZEDAZ_NR_ORYG_COLUMN=dok_NrPelnyOryg
#export MSSQL_SPRZEDAZ_UWAGI_COLUMN=dok_Uwagi
#
# Limit pojedynczego zapytania do bazy Subiekta [ms]. Domyślnie 30000 —
# 15 s drivera bywało za mało dla odczytów wsadowych importu (stany to
# ponad sto tysięcy wierszy) na maszynie obciążonej pracującym Subiektem.
#export MSSQL_REQUEST_TIMEOUT_MS=30000

# ── Pytania klientów: szkice odpowiedzi (0.80.0) ────────────────────────────
#
# Zakładka PYTANIA KLIENTÓW w /biuro ściąga pytania z Centrum wiadomości
# Allegro, przygotowuje szkic odpowiedzi (kartoteka, stany, zamienniki, linki
# do naszych aukcji) i po akceptacji człowieka wysyła ją do klienta.
#
# Domyślnie WYŁĄCZONE na produkcji (puste AI_PROVIDER przy SGT_MODE=mssql):
# zakładka mówi wtedy wprost, co dopisać. W trybie seeded działa doradca DEV —
# odpowiedzi fikcyjne, składane z kontekstu, bez wychodzenia w internet.
#
# UWAGA NA UPRAWNIENIA ALLEGRO. Ta funkcja czyta i PISZE w Centrum wiadomości
# oraz czyta nasze oferty, czyli potrzebuje uprawnień, których zwroty nie
# wymagały: allegro:api:messaging i allegro:api:sale:offers:read. Dopisanie
# ich na developer.allegro.pl nie wystarcza — token wydany pod stary zakres
# sam się nie rozszerzy, więc konto trzeba SPAROWAĆ PONOWNIE
# (/biuro → ZWROTY → KONTO ALLEGRO).
#
# PRYWATNOŚĆ. Treść pytania klienta (a przy wklejce — obraz ze schowka) idzie
# do zewnętrznego dostawcy modelu. To decyzja właściciela firmy, nie
# ustawienie techniczne. Samego obrazu nie zapisujemy u siebie: zostaje
# wyłącznie przepisana treść pytania.

# Dostawca modelu: anthropic | openai | dev.
# Puste = wg SGT_MODE (seeded → dev, mssql → funkcji nie ma).
#
# TU IDZIE NAZWA DOSTAWCY, NIE KLUCZ. Klucz stoi w linijce niżej i pomyłka
# zdarzyła się na produkcji: serwer odmówił startu, a NSSM podnosił go w pętli,
# dopisując kopię klucza do dziennika przy każdym obiegu. Od 0.84.1 komunikat
# błędu maskuje taką wartość i wskazuje właściwe pole, ale klucz i tak trzeba
# było wtedy unieważnić.
#export AI_PROVIDER=anthropic

# Klucz API — wymagany przy wybranym dostawcy, inaczej serwer nie wystartuje
# (lepiej twardy błąd przy starcie niż przy pierwszym pytaniu klienta).
# Anthropic: console.anthropic.com · OpenAI: platform.openai.com
#export ANTHROPIC_API_KEY=sk-ant-...
#export OPENAI_API_KEY=sk-...

# Model. Puste = domyślny dla dostawcy (anthropic: claude-opus-5,
# openai: gpt-4o). MUSI obsługiwać obrazy — inaczej wklejony screenshot
# pytania nie zadziała.
#export AI_MODEL=claude-opus-5

# Ile czekamy na odpowiedź modelu [ms]. Minuta, nie dziesięć sekund jak przy
# Allegro: odpowiedź z obrazem trwa dziesiątki sekund, a szkice liczą się
# w tle i nikt nie patrzy na zegarek.
#export AI_TIMEOUT_MS=60000
#
# Częstotliwość ściągania pytań dzieli pokrętło z zapowiedziami zwrotów
# (ALLEGRO_POLL_MS) — to ta sama praca na tym samym koncie. Od 0.85.0 pokrętło
# jest domyślnie na ZERZE: pytania i zapowiedzi pobiera człowiek przyciskiem
# w panelu biura. Liczba milisekund przywraca pobieranie w tle.

# ── Strefa czasowa do WYŚWIETLANIA godzin ───────────────────────────────────
#
# W bazie wszystko zostaje w UTC — to jest wyłącznie warstwa prezentacji
# (godziny w kolejce zapisów). Ustawienie, nie strefa maszyny: serwer bywa
# postawiony z angielskiego obrazu systemu, a wtedy godzina na kolektorze
# rozjeżdża się z zegarem na ścianie bez żadnego tropu.
#export STREFA_CZASU=Europe/Warsaw

# ── Druga instancja na tej samej maszynie (dev obok produkcji) ──────────────
#
# Instalator stawia ją przełącznikiem -Dev (DEPLOY.md, rozdział o środowisku
# dev). Przy stawianiu RĘCZNYM trzy klucze rozstrzygają o izolacji:
#
# PORT — bez niego druga instancja wejdzie na 3001 i przegra z produkcją.
#export PORT=3002
#
# DB_PATH — domyślna ścieżka liczy się względem katalogu instalacji, więc dwa
# OSOBNE katalogi mają osobne bazy same z siebie. Ten klucz jest potrzebny
# wyłącznie przy dwóch procesach z JEDNEGO katalogu — wtedy bez niego oba
# piszą do tej samej bazy, a to psuje się bez jednego komunikatu.
#export DB_PATH=C:\wertis-dev\server\data\wertis.db
#
# SRODOWISKO — etykieta instancji, nie tryb. /api/health ją zwraca, a biuro
# i kolektor rysują z niej czerwone ostrzeżenie. Produkcja NIE ustawia nic.
#export SRODOWISKO=dev

# ── Reszta ma sensowne domyślne ─────────────────────────────────────────────